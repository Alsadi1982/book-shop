<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Включаем базовую конфигурацию Spring Boot -->
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <!-- Переменные из application.properties -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name"/>

    <!-- Консольный аппендер (для kubectl logs) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- Loki аппендер -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${LOKI_URL:-http://loki:3100/loki/api/v1/push}</url>
            <!-- Таймаут соединения -->
            <connectionTimeout>5000</connectionTimeout>
            <requestTimeout>5000</requestTimeout>
        </http>
        <format>
            <!-- Лейблы для фильтрации в Grafana -->
            <label>
                <pattern>
                    application=${APP_NAME},host=${HOSTNAME},level=%level
                </pattern>
                <readMarkers>true</readMarkers>
            </label>
            <!-- Структурированное сообщение в JSON -->
            <message>
                <pattern>
                    {
                    "timestamp":"%d{yyyy-MM-dd HH:mm:ss.SSS}",
                    "level":"%level",
                    "logger":"%logger{36}",
                    "thread":"%thread",
                    "message":"%msg",
                    "exception":"%ex{full}",
                    "mdc":"%mdc"
                    }
                </pattern>
            </message>
            <sortByTime>true</sortByTime>
        </format>
    </appender>

    <!-- Настройки уровней логирования -->
    <logger name="com.otus.book_catalog_service" level="INFO"/>
    <logger name="com.otus.book_catalog_service.rest" level="DEBUG"/>
    <logger name="io.github.resilience4j.circuitbreaker" level="DEBUG"/>
    <logger name="io.github.resilience4j.ratelimiter" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>

    <!-- Корневой логер -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>
</configuration>